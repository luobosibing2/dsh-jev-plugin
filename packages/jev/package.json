{
  "name": "@dsh-jev/plugin",
  "version": "0.1.0",
  "description": "deepseek-harness-jev: native DeepSeek Harness (DSH) plugin integrating TypeSafe Jev / System One for selection, supervision, corrections, tool-output filtering, and approvals",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./selection": {
      "types": "./lib/types/selection.d.ts",
      "default": "./lib/selection.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./stage-types": {
      "types": "./lib/types/stage-types.d.ts",
      "default": "./lib/types/stage-types.js"
    },
    "./stage-navigation": {
      "types": "./lib/types/stage-navigation.d.ts",
      "default": "./lib/stage-navigation.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./supervision": {
      "types": "./lib/types/supervision.d.ts",
      "default": "./lib/supervision.js"
    },
    "./instructions": {
      "types": "./lib/types/instructions.d.ts",
      "default": "./lib/instructions.js"
    },
    "./shared-findings": {
      "types": "./lib/types/shared-findings.d.ts",
      "default": "./lib/shared-findings.js"
    },
    "./interjection": {
      "types": "./lib/types/interjection.d.ts",
      "default": "./lib/interjection.js"
    },
    "./workspace-approval": {
      "types": "./lib/types/workspace-approval.d.ts",
      "default": "./lib/workspace-approval.js"
    },
    "./output-admission": {
      "types": "./lib/types/output-admission.d.ts",
      "default": "./lib/output-admission.js"
    }
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.2",
