{
  "name": "@dsh-jev/plugin",
  "version": "0.1.0",
  "description": "deepseek-harness-jev: native DeepSeek Harness (DSH) plugin integrating TypeSafe Jev / System One for selection, supervision, corrections, tool-output filtering, and approvals",
  "type": "module",
  "main": "./runtime/index.js",
  "types": "./runtime/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./runtime/types/index.d.ts",
      "default": "./runtime/index.js"
    },
    "./selection": {
      "types": "./runtime/types/selection.d.ts",
      "default": "./runtime/selection.js"
    },
    "./types": {
      "types": "./runtime/types/types.d.ts",
      "default": "./runtime/types/types.js"
    },
    "./stage-types": {
      "types": "./runtime/types/stage-types.d.ts",
      "default": "./runtime/types/stage-types.js"
    },
    "./stage-navigation": {
      "types": "./runtime/types/stage-navigation.d.ts",
      "default": "./runtime/stage-navigation.js"
    },
    "./remote": {
      "types": "./runtime/typert.remote-client.d.ts",
      "default": "./runtime/typert.remote-client.js"
    },
    "./typert": {
      "types": "./runtime/typert.host.d.ts",
      "default": "./runtime/typert.host.js"
    },
    "./client": {
      "types": "./runtime/types/client/index.d.ts",
      "default": "./runtime/client.js"
    },
    "./cordis.patch.yml": "./packages/jev/cordis.patch.yml",
    "./package.json": "./package.json",
    "./supervision": {
      "types": "./runtime/types/supervision.d.ts",
      "default": "./runtime/supervision.js"
    },
    "./instructions": {
      "types": "./runtime/types/instructions.d.ts",
      "default": "./runtime/instructions.js"
    },
    "./shared-findings": {
      "types": "./runtime/types/shared-findings.d.ts",
      "default": "./runtime/shared-findings.js"
    },
    "./interjection": {
      "types": "./runtime/types/interjection.d.ts",
      "default": "./runtime/interjection.js"
    },
    "./workspace-approval": {
      "types": "./runtime/types/workspace-approval.d.ts",
      "default": "./runtime/workspace-approval.js"
    },
    "./output-admission": {
      "types": "./runtime/types/output-admission.d.ts",
      "default": "./runtime/output-admission.js"
    }
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "bundle": {
      "patch": "./packages/jev/cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-fs": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-skill": "0.2.1-alpha.2",
