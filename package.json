    "README.md",
    "README.en.md",
    "README.zh-CN.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "zod": "^4.4.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luobosibing2/deepseek-harness-jev.git"
  },
  "homepage": "https://github.com/luobosibing2/deepseek-harness-jev#readme",
  "bugs": {
    "url": "https://github.com/luobosibing2/deepseek-harness-jev/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "jev",
    "typesafe-ai",
    "system-one",
    "agent-harness",
    "dsh-plugin",
    "agent-supervision",
    "skill-selection",
    "tool-output-filtering"
  ],
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "typecheck": "node scripts/sync-typert-protocol.mjs && tsc -b tsconfig.host.json && node scripts/generate-typert.mjs && tsc -b tsconfig.client.json",
    "build": "node scripts/sync-typert-protocol.mjs && tsc -b tsconfig.host.json && tsdown -c tsdown.config.ts && node scripts/generate-typert.mjs && tsc -b tsconfig.client.json && tsdown --config packages/jev/tsdown.client.ts && node scripts/sync-github-runtime.mjs",
    "test": "vitest run --exclude '**/.artifacts/**'"
  }
}
